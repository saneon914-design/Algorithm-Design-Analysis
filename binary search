#include<iostream>
using namespace std;
int BinarySearch(int arr[], int size, int key){
int head =0;
int tail = size -1;
while (head <= tail){
    int mid = head + (tail - head) /2;
    if (arr[mid] == key)
    return mid;
    else if (arr[mid] < key )
    head = mid + 1 ;
    else
        tail = mid -1;

    }
    return -1;


}
int main(){
    int number;
    cout << "Enter the number of elements in the array:";
    cin >> number;
    int arr[number];
    cout << " Enter the elments in the array in sorted order;<<endl";
    for (int i = 0; i < number; i++){
        cin >> arr[i];
        


    }
    int key;
    cout << "Enter the element to search for:";
    cin >> key;
    int result = BinarySearch(arr, number, key);
    if (result == -1){
        cout << "Element not found";
    }
    else{
        cout << "Element found at index " << result;
    }

}


